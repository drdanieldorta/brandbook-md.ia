  "proposals": [
    "neutrals.*: valores observados apenas no CSS da demonstração do guia, adotados como tokens de interface",
    "dark.*: azul-noite do guia como superfície escura, mais dois tons derivados para camadas e textos secundários",
    "semantic.*: paleta de estados (sucesso, alerta, erro, informação); o guia não define paleta semântica",
    "font.family: Inter (SIL OFL) embarcada; Segoe UI/Arial do guia permanecem como fallback",
    "font.scale.heading, subheading, caption: níveis intermediários ausentes no guia",
    "radius.full: raio de pílula para badges e avatares",
    "focus.offset: deslocamento do anel de foco (não consolidado no guia)",
    "shadows.*: escala de elevação; a sombra do toast vem da demonstração",
    "breakpoints.*: grade responsiva padrão; o guia não define breakpoints",
    "zIndex.*: camadas de sobreposição",
    "layout.*: largura máxima de container e medida de linha dentro do intervalo 45–75"
  ]
}
